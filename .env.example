# ---------------------------------------------------------------------------
# Copiez ce fichier en .env.local et renseignez les valeurs.
# .env.local n'est jamais versionné.
# ---------------------------------------------------------------------------

# URL publique du site, sans slash final.
# En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse de contact affichée sur le site et utilisée en reply-to des emails.
NEXT_PUBLIC_CONTACT_EMAIL=contact@sevrance.fr

# --- Stripe ---------------------------------------------------------------
# Clé secrète. Utilisez sk_test_... tant que vous n'êtes pas en production.
STRIPE_SECRET_KEY=sk_test_xxx

# Secret de signature du webhook, fourni par `stripe listen` en local
# (whsec_...) ou par le dashboard Stripe en production.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optionnel : identifiant d'un Price Stripe existant (price_...).
# Recommandé en production pour la TVA et la comptabilité. Si absent, le
# prix est construit à la volée à partir de PRICE_EUR (src/lib/content.ts).
# STRIPE_PRICE_ID=price_xxx

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=re_xxx

# Expéditeur. Le domaine doit être vérifié dans Resend.
RESEND_FROM_EMAIL=Sevrance <contact@sevrance.fr>

# --- Livraison du PDF -----------------------------------------------------
# Secret de signature des liens de téléchargement.
# Générez-le avec : openssl rand -base64 48
DOWNLOAD_TOKEN_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# Option A : le PDF est sur le disque du serveur, hors du dossier public.
# Chemin relatif à la racine du projet.
PDF_FILE_PATH=private/sevrance.pdf

# Option B : le PDF est hébergé ailleurs (S3, R2, Bunny…). Si cette variable
# est définie, elle a la priorité sur PDF_FILE_PATH. L'URL n'est jamais
# exposée au navigateur : le serveur relaie le fichier.
# PDF_SOURCE_URL=https://exemple.com/prive/sevrance.pdf
