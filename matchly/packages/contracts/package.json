{
  "name": "@matchly/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrats partag\u00e9s Matchly : sch\u00e9mas Zod, types de domaine, enveloppes d'API.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsc --build tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@matchly/config": "*",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
