# ============================================================================
# MATCHLY — variables d'environnement
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` (racine, pour Docker + API) et en
# `apps/web/.env.local` (pour Next.js). Ne committez jamais de secret réel.
# Chaque variable est validée au démarrage par Zod : une valeur manquante ou
# malformée fait échouer le boot immédiatement plutôt qu'à la première requête.
# ============================================================================

# ---------------------------------------------------------------------------
# Commun
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# API — apps/api
# ---------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origines autorisées en CORS, séparées par des virgules.
API_CORS_ORIGINS=http://localhost:3000
# Préfixe global des routes HTTP (la version est ajoutée après : /api/v1).
API_GLOBAL_PREFIX=api
# Expose /api/docs (OpenAPI). À laisser désactivé en production publique.
API_SWAGGER_ENABLED=true
# Fenêtre et quota du rate limiter global.
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=matchly
POSTGRES_PASSWORD=matchly_dev_password
POSTGRES_DB=matchly
POSTGRES_PORT=5432
DATABASE_URL=postgresql://matchly:matchly_dev_password@localhost:5432/matchly?schema=public

# ---------------------------------------------------------------------------
# Redis — cache, pub/sub Socket.IO, rate limiting
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=matchly:

# ---------------------------------------------------------------------------
# Streaming — MediaMTX
# ---------------------------------------------------------------------------
# Point d'ingestion RTMP utilisé par OBS / l'app mobile.
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
# Base de lecture HLS servie au lecteur web.
MEDIAMTX_HLS_URL=http://localhost:8888
# Base WebRTC (WHEP) pour la latence sub-seconde.
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_API_URL=http://localhost:9997

# ---------------------------------------------------------------------------
# Web — apps/web  (les NEXT_PUBLIC_* sont exposées au navigateur)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
